{
  "name": "test-guide",
  "version": "0.3.0",
  "description": "A manual-testing companion for opencode: builds context, designs evidence-based scenarios, and guides you step by step while you run every command.",
  "type": "module",
  "bin": {
    "test-guide": "bin/install.mjs"
  },
  "files": [
    "bin",
    "skills",
    "examples"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "format": "npx --yes prettier@3.3.3 --write .",
    "format:check": "npx --yes prettier@3.3.3 --check .",
    "test": "node --test"
  },
  "keywords": [
    "opencode",
    "agent-skills",
    "manual-testing",
    "qa",
    "ai-agent",
    "testing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StaelTchinda/test-guide.git"
  }
}
